@using System.Globalization
<svg class="cube" viewBox="0 0 300 220" role="img" aria-label="Cube state"><g transform="translate(60 15)">@Face(Face.U,60,0)@Face(Face.L,0,60)@Face(Face.F,60,60)@Face(Face.R,120,60)@Face(Face.B,180,60)@Face(Face.D,60,120)</g></svg>
@code {[Parameter]public PuzzleCube State{get;set;}=PuzzleCube.Solved(3);static readonly string[] Colors=["#fff","#d32f2f","#2e7d32","#ffd600","#ef6c00","#1565c0"];RenderFragment Face(Face f,double x,double y)=>b=>{var grid=State.FaceGrid(f);var k=0;for(var r=0;r<State.Size;r++)for(var c=0;c<State.Size;c++){b.OpenElement(k++,"rect");b.AddAttribute(k++,"x",(x+c*60d/State.Size).ToString(CultureInfo.InvariantCulture));b.AddAttribute(k++,"y",(y+r*60d/State.Size).ToString(CultureInfo.InvariantCulture));b.AddAttribute(k++,"width",(60d/State.Size).ToString(CultureInfo.InvariantCulture));b.AddAttribute(k++,"height",(60d/State.Size).ToString(CultureInfo.InvariantCulture));b.AddAttribute(k++,"fill",Colors[grid[r][c]]);b.AddAttribute(k++,"stroke","#222");b.CloseElement();}};}
